# Provider configuration (names only; real values live in the service environment, never in git).
# Every provider is swappable by configuration only. See README.md and integrations/__init__.py.

# --- Razorpay (India payments) and RazorpayX (India payouts): the default for India ---
# Test vs live is decided by the key prefix (rzp_test_ / rzp_live_). A rzp_live_ key is REFUSED
# unless ENVIRONMENT=production, so QA can only ever use rzp_test_ keys.
# Payments (required): the key pair. RAZORPAY_WEBHOOK_SECRET is the secret you set on the
# dashboard webhook for /api/v1/webhooks/razorpay/ (missing = deliveries rejected, a warning).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payouts (RazorpayX). RAZORPAYX_ACCOUNT_NUMBER (required) is the RazorpayX account that is
# debited (it differs between test and live). RAZORPAYX_KEY_ID / RAZORPAYX_KEY_SECRET are optional
# and default to the RAZORPAY_* pair. RAZORPAYX_WEBHOOK_SECRET is for /api/v1/webhooks/razorpayx/.
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=

# --- Cashfree (kept in the code, configured NOWHERE by default; select it only via
#     PAYMENT_PROVIDERS_JSON / PAYOUT_PROVIDERS_JSON) ---
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional: PG webhooks are signed with CASHFREE_SECRET_KEY when this is unset.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
# Optional host overrides (ignored if they name the other environment's host).
CASHFREE_PG_BASE_URL=
CASHFREE_PAYOUTS_BASE_URL=

# --- Which provider serves which country ---
# Payments: cashfree | razorpay | stripe   Payouts: cashfree | razorpay (alias razorpayx) | stripe_connect
# Unset default: {"IN": "razorpay", "US": null}. Other countries have none. The old global
# PAYMENT_GATEWAY / PAYOUT_GATEWAY names have no default and are read only if set.
PAYMENT_PROVIDERS_JSON=
PAYOUT_PROVIDERS_JSON=
# Notifications, merged over the defaults: {"sms": {"US": "sns"}, "push": {"IN": "sns"}}
NOTIFY_PROVIDERS_JSON=

# --- Notifications master switches ---
NOTIFY_LIVE_SEND=false
NOTIFY_TEST_RECIPIENTS=

# --- AWS SNS SMS and push (sandbox-only until the owner confirms the AWS account) ---
SNS_LIVE_CONFIRMED=false
SNS_AWS_ACCESS_KEY_ID=
SNS_AWS_SECRET_ACCESS_KEY=
SNS_AWS_REGION=
SNS_SMS_SENDER_ID=
SNS_PLATFORM_APPLICATION_ARN_FCM=
SNS_PLATFORM_APPLICATION_ARN_APNS=
