# Provider configuration (names only; real values live in the service environment, never in git).
# Every provider is swappable by configuration only. See README.md and integrations/__init__.py.

# --- Cashfree (India payments and payouts) ---
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional: PG webhooks are signed with CASHFREE_SECRET_KEY when this is unset.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
# Optional host overrides (ignored if they name the other environment's host).
CASHFREE_PG_BASE_URL=
CASHFREE_PAYOUTS_BASE_URL=

# --- Which provider serves which country ---
# Payments: cashfree | razorpay | stripe   Payouts: cashfree | razorpay | stripe_connect
# Unset: PAYMENT_GATEWAY / PAYOUT_GATEWAY is India's provider, other countries have none.
PAYMENT_PROVIDERS_JSON=
PAYOUT_PROVIDERS_JSON=
# Notifications, merged over the defaults: {"sms": {"US": "sns"}, "push": {"IN": "sns"}}
NOTIFY_PROVIDERS_JSON=

# --- Notifications master switches ---
NOTIFY_LIVE_SEND=false
NOTIFY_TEST_RECIPIENTS=

# --- AWS SNS SMS and push (sandbox-only until the owner confirms the AWS account) ---
SNS_LIVE_CONFIRMED=false
SNS_AWS_ACCESS_KEY_ID=
SNS_AWS_SECRET_ACCESS_KEY=
SNS_AWS_REGION=
SNS_SMS_SENDER_ID=
SNS_PLATFORM_APPLICATION_ARN_FCM=
SNS_PLATFORM_APPLICATION_ARN_APNS=
